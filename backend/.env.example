# --- DB ---
DATABASE_URL="postgresql://username:password@localhost:5432/dbname"
TEST_DATABASE_URL="postgresql://zombiezone:zombiezone@localhost:5432/zombiezone_test"

# --- Server ---
FRONTEND_URL=https://sharo.fr
# 4000 en local : kadath.fr occupe le 3000 (next dev). Dans le conteneur de
# prod, nginx proxifie backend:3000 — ne pas y toucher sans changer nginx.conf.
PORT=4000
NODE_ENV=development
# Origines des navigateurs, pas celle de l'API : le front Vite est en 5173.
ALLOWED_ORIGINS=http://localhost:5173,https://sharo.fr
LOG_LEVEL=warn

# --- Admin ---
ADMIN_EMAIL=steph@sharo.fr
ADMIN_FIRSTNAME=Steph
ADMIN_LASTNAME=O'clock Alumni
ADMIN_PASSWORD=x

# --- Security ---
JWT_ACCESS_SECRET=x
JWT_REFRESH_SECRET=x
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PASSWORDS_BLACKLIST=Passw0rd, Password123

# --- SMTP ---
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_USER=z0mbiez0ne@sharo.fr
SMTP_PASS=your_smtp_password_here
SMTP_FROM="zØmbie zØne <z0mbiez0ne@sharo.fr>"